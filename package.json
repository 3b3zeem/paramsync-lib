{
  "name": "paramsync",
  "version": "1.0.3",
  "description": "Zero-overhead, type-safe URL Search Params state manager for React & Next.js App Router applications.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "prepack": "node scripts/prepare-npm-readme.js",
    "postpack": "node scripts/restore-github-readme.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3b3zeem/paramsync.git"
  },
  "homepage": "https://paramsync.vercel.app",
  "bugs": {
    "url": "https://github.com/3b3zeem/paramsync/issues"
  },
  "keywords": [
    "react",
    "nextjs",
    "app-router",
    "next-navigation",
    "searchparams",
    "use-search-params",
    "use-query-params",
    "use-query-state",
    "query-state",
    "url-state",
    "url-params",
    "filters",
    "facet-filters",
    "filter-drawer",
    "sorting",
    "pagination",
    "nuqs",
    "nuqs-alternative",
    "type-safe",
    "paramsync"
  ],
  "author": "Ahmed Mostafa <ahmedmostafaabdel3azem@gmail.com>",
  "license": "MIT",
  "type": "module",
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": false
    },
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

